# --- Database -------------------------------------------------------------
# Local dev uses a SQLite file. In production use Turso (libsql://...).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32   (REQUIRED in production)
AUTH_SECRET=

# Public URL of the site (used in emails, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin account created by `npm run db:seed` ---------------------------
ADMIN_EMAIL=admin@beautypeps.com.au
ADMIN_PASSWORD=ChangeMe-Peps-2026!

# --- Email (optional) ----------------------------------------------------
# Without these, emails are only written to Admin -> Emails.
RESEND_API_KEY=
EMAIL_FROM="Beauty Peps <orders@beautypeps.com.au>"

# --- Image uploads (optional) ---------------------------------------------
# Without this, admin uploads are saved to /public/uploads (local dev only).
BLOB_READ_WRITE_TOKEN=

# --- Shared stock with AuPeptideLabs (optional) ----------------------------
# Products with an "AuPeptideLabs variant" sell from APL's shelf: stock is read from APL, a paid order takes its
# units off it, a restocked cancel/refund puts them back. APL's database only answers calls carrying this token
# (it stores the sha256 of it in public.beautypeps_tokens). Without these, linked products keep their last stock.
APL_SUPABASE_URL=https://jpgpxpqnaxuxrbrzxqnj.supabase.co
APL_SUPABASE_PUBLISHABLE_KEY=
APL_STOCK_TOKEN=

# Protects /api/cron/stock (daily: expire unpaid orders, retry stock takes, re-read APL's shelf).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>" when this is set on the project.
CRON_SECRET=
